{
  "manifest_version": 3,
  "name": "StockPeek",
  "version": "2.0.0",
  "description": "Peek at any stock, index, or crypto — hover to expand a live chart. Alerts, news, stats and more.",
  "permissions": ["storage", "alarms", "clipboardWrite"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "StockPeek",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "commands": {
    "toggle-widget": {
      "suggested_key": {
        "default": "Alt+M",
        "mac":     "Ctrl+Shift+M"
      },
      "description": "Toggle market widget"
    }
  },
  "host_permissions": [
    "https://query1.finance.yahoo.com/*",
    "https://query2.finance.yahoo.com/*"
  ],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
